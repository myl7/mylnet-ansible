        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (gpu) (label_join(gpu_memory_total_MiB, \"gpu\", \"-\", \"hostname\", \"index\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "C"
