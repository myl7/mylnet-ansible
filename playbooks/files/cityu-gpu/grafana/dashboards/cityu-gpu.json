        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (gpu) (label_join(gpu_temperature_C, \"gpu\", \"-\", \"hostname\", \"index\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "D"
        }
