          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (gpu) (label_join(gpu_memory_used_MiB, \"gpu\", \"-\", \"hostname\", \"index\"))",
