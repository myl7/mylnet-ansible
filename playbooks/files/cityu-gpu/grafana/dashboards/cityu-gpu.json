          "editorMode": "code",
          "expr": "sum(gpu_memory_total_MiB - gpu_memory_used_MiB) / 1024",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "空闲显存 (GiB)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
