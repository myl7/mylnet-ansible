services:
  mylnet-proxy-rules:
    build: /srv/mylnet/mylnet-proxy-rules
    image: mylnet-proxy-rules:local
    # Local-only image, built on this host. Never let compose try a registry.
    pull_policy: never
    restart: always
    environment:
      # The app shells out to ansible-playbook inside the mounted checkouts and
      # commits the rule file in the secrets repo, so both need the same paths
      # in and out of the container for the playbooks/secrets symlink to resolve.
      - MYLNET_ANSIBLE_DIR=/srv/mylnet/mylnet-ansible
      - MYLNET_SECRETS_DIR=/srv/mylnet/mylnet-ansible-secrets
      - MYLNET_VERIFY_URL=https://{{ proxy_sub_domain }}/{{ proxy_sub_id }}
      # The container manages the sg host through its own public address. Its
      # ssh known_hosts is empty, so the strict checks would block the first run.
      - ANSIBLE_SSH_ARGS=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
      - GIT_SSH_COMMAND=ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
    volumes:
      - /srv/mylnet/mylnet-ansible:/srv/mylnet/mylnet-ansible
      - /srv/mylnet/mylnet-ansible-secrets:/srv/mylnet/mylnet-ansible-secrets
      # The keypair for the container's ssh to myl@sg lives here, generated on
      # this host, public half in myl's authorized_keys. Read-only is enough:
      # ssh only reads the private key.
      - /srv/mylnet/.ssh:/home/app/.ssh:ro
    ports:
      - "127.0.0.1:{{ prules_local_port }}:8000"
    logging:
      driver: local
