server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ prules_domain }};

    ssl_certificate {{ prules_cert }};
    ssl_certificate_key {{ prules_key }};

    # Session-cached basic auth: one bcrypt verification per credential
    # per 10 minutes, see snippets/auth-session.conf.
    set $basic_auth_file mylnet-proxy-rules;
    include snippets/auth-session.conf;

    location / {
        auth_request /_auth;
        proxy_pass http://127.0.0.1:{{ prules_local_port }};
        include snippets/rproxy.conf;
    }
}
