server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ prules_domain }};

    ssl_certificate {{ prules_cert }};
    ssl_certificate_key {{ prules_key }};

    location / {
        auth_basic "mylnet-proxy-rules";
        auth_basic_user_file /etc/nginx/htpasswd/mylnet-proxy-rules;
        proxy_pass http://127.0.0.1:{{ prules_local_port }};
        include snippets/rproxy.conf;
    }
}
