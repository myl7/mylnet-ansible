server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ dav_domain }};

    ssl_certificate {{ dav_cert }};
    ssl_certificate_key {{ dav_key }};

    # Session-cached basic auth: one bcrypt verification per credential
    # per 10 minutes, see snippets/auth-session.conf.
    set $auth_file dav;
    include snippets/auth-session.conf;

    location /public/ {
        root /srv/share/dav;
        fancyindex on;
        fancyindex_localtime on;
        fancyindex_time_format "%Y-%m-%d %T %z";
        fancyindex_default_sort date_desc;
        fancyindex_exact_size off;
        fancyindex_name_length 80;

        include snippets/rproxy.conf;

        # auth_request cannot be placed inside limit_except, and it does not
        # evaluate variables either (tested: the subrequest goes to the
        # literal "$var" URI), so no method gating and no session cache
        # here: keep the plain uncached auth_basic pair, same as before.
        limit_except GET HEAD {
            auth_basic "dav";
            auth_basic_user_file /etc/nginx/htpasswd/dav;
            proxy_pass http://127.0.0.1:{{ dav_local_port }};
        }
    }

    location / {
        auth_request /_auth;
        proxy_pass http://127.0.0.1:{{ dav_local_port }};
        include snippets/rproxy.conf;
    }
}
