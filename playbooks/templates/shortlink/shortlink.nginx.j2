server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ shortlink_domain }};

    ssl_certificate {{ shortlink_cert }};
    ssl_certificate_key {{ shortlink_key }};

    # The links are used in double-blind rebuttals, where the conferences
    # require the host to not track visitors: no access log here.
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:{{ shortlink_local_port }};
        include snippets/rproxy.conf;
    }
}
