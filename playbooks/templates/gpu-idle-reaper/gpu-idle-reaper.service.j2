[Unit]
Description=Kill GPU processes that hold a CUDA context without computing
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
StateDirectory=gpu-idle-reaper
ExecStart=/opt/gpu-idle-reaper/bin/python /opt/gpu-idle-reaper/gpu_idle_reaper.py --hostname {{ inventory_hostname }} --metrics-address {{ tailnet_ip }} --metrics-port {{ gpu_idle_reaper_port }} --state-file /var/lib/gpu-idle-reaper/state.json --idle-seconds {{ gpu_idle_reaper_idle_seconds }} --grace-seconds {{ gpu_idle_reaper_grace_seconds }}{{ ' --dry-run' if gpu_idle_reaper_dry_run else '' }}
StandardOutput=append:/var/log/gpu-idle-reaper.log
StandardError=inherit
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
