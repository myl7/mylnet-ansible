server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ cityu_gpu_domain }};

    ssl_certificate {{ cityu_gpu_cert }};
    ssl_certificate_key {{ cityu_gpu_key }};

    location / {
        auth_basic "cityu-gpu";
        auth_basic_user_file /etc/nginx/htpasswd/cityu-gpu;
        proxy_pass http://127.0.0.1:{{ cityu_gpu_grafana_local_port }};
        include snippets/rproxy.conf;
    }
}
