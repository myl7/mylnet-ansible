# clash_tailnet selects the flavor. true renders the tailnet subscription
# (TAILNET outbound, *-tailnet nodes, tailnet DNS policy and rules) for
# FlClash-class clients that carry the tailnet inside the subscription;
# false renders the plain subscription for clients with native tailscale
# or no tailnet at all.
log-level: info
mixed-port: 7890
allow-lan: false
ipv6: false
mode: rule
unified-delay: true
profile:
  store-selected: true

sniffer:
  enable: true
  parse-pure-ip: true
  force-dns-mapping: true
  override-destination: false
  sniff:
    HTTP:
      ports:
        - 80
        - 443
    TLS:
      ports:
        - 443
  skip-domain:
    # Apple push uses long-lived connections.
    # Sniffing and rewriting will break the push connection.
    - +.push.apple.com
  skip-dst-address:
    # Telegram: Their MTProto uses non-standard TLS without a proper SNI.
    # Sniffing will only yield wrong domains or disrupt the connection.
    - 91.105.192.0/23
    - 91.108.4.0/22
    - 91.108.8.0/21
    - 91.108.16.0/21
    - 91.108.56.0/22
    - 95.161.64.0/20
    - 149.154.160.0/20
    - 185.76.151.0/24
    - 2001:67c:4e8::/48
    - 2001:b28:f23c::/47
    - 2001:b28:f23f::/48
    - 2a0a:f280:203::/48

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*"
    - +.lan
    - +.local
    - time.*.com
    - ntp.*.com
    - +.market.xiaomi.com
    - "*.ts.net"
  fake-ip-filter-mode: blacklist
  use-hosts: false
  use-system-hosts: true
  respect-rules: true
  default-nameserver:
    - tls://223.5.5.5
    - tls://1.1.1.1
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://1.1.1.1/dns-query
  proxy-server-nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://1.1.1.1/dns-query
  direct-nameserver: []
{% if clash_tailnet %}
  nameserver-policy:
    "+.{{ clash_tailnet_domain }}": ts://TAILNET
{% endif %}
  fallback: []
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
      - 0.0.0.0/32
    domain:
      - +.google.com
      - +.facebook.com
      - +.youtube.com

geodata-mode: false
geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip-lite.dat"
  geosite: "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat"
  mmdb: "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb"
  asn: "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb"

proxies:
{% for proxy_host in proxy_hostnames %}
  - name: {{ proxy_host | to_json }}
    type: vless
    server: {{ proxy_hosts[proxy_host] | to_json }}
    port: {{ proxy_ports[proxy_host] }}
    udp: true
    uuid: {{ proxy_vless_credentials[proxy_host].uuid | to_json }}
    flow: xtls-rprx-vision
    packet-encoding: xudp
    tls: true
    servername: {{ proxy_reality_server_name | to_json }}
    client-fingerprint: chrome
    reality-opts:
      public-key: {{ proxy_vless_credentials[proxy_host].reality_public_key | to_json }}
      short-id: {{ proxy_vless_credentials[proxy_host].reality_short_id | to_json }}
    encryption: ""
    network: tcp
    smux:
      enabled: false
{% endfor %}

{% if clash_tailnet %}
{% for proxy_host in proxy_hostnames %}
  # {{ proxy_host }}-tailnet: the same VLESS service, dialed through the
  # TAILNET outbound (dialer-proxy) at its tailnet address. Works wherever
  # the tailnet is reachable, also when the public endpoint is not.
  - name: {{ (proxy_host ~ '-tailnet') | to_json }}
    type: vless
    server: {{ proxy_tailnet_ips[proxy_host] | to_json }}
    port: {{ proxy_ports[proxy_host] }}
    udp: true
    uuid: {{ proxy_vless_credentials[proxy_host].uuid | to_json }}
    flow: xtls-rprx-vision
    packet-encoding: xudp
    tls: true
    servername: {{ proxy_reality_server_name | to_json }}
    client-fingerprint: chrome
    reality-opts:
      public-key: {{ proxy_vless_credentials[proxy_host].reality_public_key | to_json }}
      short-id: {{ proxy_vless_credentials[proxy_host].reality_short_id | to_json }}
    encryption: ""
    network: tcp
    dialer-proxy: TAILNET
    smux:
      enabled: false
{% endfor %}

  # cu-tailnet: cu runs no VLESS service. Its SOCKS at the cityu-print
  # transport port (no auth) egresses on the CityU campus network, also
  # dialed through the TAILNET outbound.
  - name: cu-tailnet
    type: socks5
    server: {{ hostvars['cu'].tailnet_ip | to_json }}
    port: {{ cityu_print_socks_port }}
    udp: false
    dialer-proxy: TAILNET

  # TAILNET keeps its identity in state-dir. The optional
  # clash_tailscale_auth_key secret (secrets.yaml) enables a headless first
  # login: deploy with the key, log in once, remove the key.
  # dialer-proxy routes the tailnet control plane through ts-underlay. The
  # phone runs the fixed core (mihomo#3142 wildcard proxydialer fix, fork
  # v0.9.0-myl7.1); stock cores drop tailnet traffic with this set, so only
  # the fixed-core build may consume this flavor.
  - name: TAILNET
    type: tailscale
    hostname: {{ clash_tailscale_hostname | to_json }}
{% if clash_tailscale_auth_key is defined %}
    auth-key: {{ clash_tailscale_auth_key | to_json }}
{% endif %}
    state-dir: ./tailscale
    dialer-proxy: ts-underlay
    ephemeral: false
    udp: true
    accept-routes: true
    ip-version: ipv4-prefer
{% endif %}

proxy-groups:
  - name: default
    type: select
    proxies:
      - DIRECT
      - proxy
  - name: proxy
    type: select
    proxies:
{% for proxy_host in proxy_hostnames | move_first(proxy_proxy_hostname) %}
      - {{ proxy_host | to_json }}
{% endfor %}
{% if clash_tailnet %}
{% for proxy_host in proxy_hostnames %}
      - {{ (proxy_host ~ '-tailnet') | to_json }}
{% endfor %}
      - cu-tailnet
{% endif %}
      - DIRECT
  - name: cn
    type: select
    proxies:
      - DIRECT
{% for proxy_host in proxy_hostnames %}
      - {{ proxy_host | to_json }}
{% endfor %}
{% if clash_tailnet %}
      - cu-tailnet
{% endif %}
  - name: ai
    type: select
    proxies:
{# AI requires stable IPs, so we do not use the proxy group #}
{% for proxy_host in proxy_hostnames | move_first(proxy_ai_hostname) %}
      - {{ proxy_host | to_json }}
{% endfor %}
      - DIRECT

{% if clash_tailnet %}
  # Underlay selection for the TAILNET outbound: control plane, DERP and
  # WireGuard traffic. Dormant until the subscription's TAILNET outbound
  # carries dialer-proxy (needs a core with the wildcard proxydialer fix,
  # mihomo#3142). The *-tailnet nodes dial through TAILNET and would loop;
  # they must never join this group.
  - name: ts-underlay
    type: select
    proxies:
      - DIRECT
{% for proxy_host in proxy_hostnames %}
      - {{ proxy_host | to_json }}
{% endfor %}
{% endif %}

{% set openai_asns = [401518, 401864] %}{# OpenAI #}
{% set anthropic_asns = [399358] %}{# Anthropic #}
{% set proxy_ai_asns = proxy_ai_asns | default(openai_asns + anthropic_asns) %}

rule-providers:
  anti-ad:
    type: http
    behavior: domain
    format: yaml
    url: "https://anti-ad.net/clash.yaml"
    path: ./ruleset/anti-ad.yaml
    interval: 86400

rules:
{% if clash_tailnet %}
  # Tailnet destinations must precede GEOSITE/GEOIP private, which would
  # otherwise send 100.64.0.0/10 traffic to DIRECT.
  - DOMAIN-SUFFIX,{{ clash_tailnet_domain }},TAILNET
  - IP-CIDR,100.64.0.0/10,TAILNET,no-resolve
  - IP-CIDR,100.100.100.100/32,TAILNET,no-resolve
{% else %}
  # Plain flavor: the tailnet range falls through to the private rules
  # below and goes DIRECT, which is right for clients with native
  # tailscale and harmless for clients without one.
{% endif %}
  - GEOSITE,private,DIRECT
  - GEOIP,private,DIRECT,no-resolve
  - DOMAIN-SUFFIX,ts.net,DIRECT

  - RULE-SET,anti-ad,REJECT

  - DOMAIN,downloads.claude.ai,default
  - DOMAIN-KEYWORD,claude,ai
  - DOMAIN-KEYWORD,anthropic,ai
  - DOMAIN-KEYWORD,chatgpt,ai
  - DOMAIN-KEYWORD,openai,ai
  - DOMAIN-KEYWORD,gemini,ai
  - DOMAIN-SUFFIX,aistudio.google.com,ai
  - DOMAIN-SUFFIX,generativelanguage.googleapis.com,ai
  - DOMAIN-KEYWORD,openrouter,ai
  - DOMAIN-KEYWORD,groq,ai

{{ lookup('ansible.builtin.file', 'secrets/clash_rules_extend.yaml').split('\n')[1:] | join('\n') }}

  - GEOSITE,cn,cn

{% for proxy_ai_asn in proxy_ai_asns %}
  - IP-ASN,{{ proxy_ai_asn }},ai
{% endfor %}

  - GEOIP,CN,cn
  - MATCH,default
