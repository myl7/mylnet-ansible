[Unit]
Description=Track idle GPU processes and end them on request
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
StateDirectory=gpu-idle-kill
RuntimeDirectory=gpu-idle-kill
ExecStart=/opt/gpu-idle-kill/bin/python /opt/gpu-idle-kill/gpu_idle_kill.py --hostname {{ inventory_hostname }} --metrics-address {{ tailnet_ip }} --metrics-port {{ gpu_idle_kill_port }} --socket /run/gpu-idle-kill/kill.sock --state-file /var/lib/gpu-idle-kill/state.json --idle-seconds {{ gpu_idle_kill_idle_seconds }} --grace-seconds {{ gpu_idle_kill_grace_seconds }}{{ ' --dry-run' if gpu_idle_kill_dry_run else '' }}
StandardOutput=append:/var/log/gpu-idle-kill.log
StandardError=inherit
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
