server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ webobsidian_domain }};

    ssl_certificate {{ webobsidian_cert }};
    ssl_certificate_key {{ webobsidian_key }};

    # Web Obsidian authenticates with its own master password, so the vhost
    # carries no auth of its own (same tradeoff as the syncthing vhost).
    location / {
        proxy_pass http://127.0.0.1:{{ webobsidian_port }};
        include snippets/rproxy.conf;
    }
}
