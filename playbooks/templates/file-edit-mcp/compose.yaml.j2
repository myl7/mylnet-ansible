services:
  file-edit-mcp:
    image: {{ file_edit_mcp_image }}
    container_name: file-edit-mcp
    restart: always
    # Token-path auth: the MCP endpoint lives at /<token>/mcp and the server
    # rejects every other path, so the token env var IS the auth layer. nginx
    # passes through without basic auth; the port below stays loopback-only.
    # --allow scopes it to the notes vault, not the whole share.
    command:
      ["--transport", "http", "--addr", ":8080", "--allow", "/srv/share/obsidian/notes"]
    environment:
      FILE_EDIT_MCP_TOKEN: "{{ file_edit_mcp_token }}"
      # Single token today; the server (v0.4.0+) also accepts
      # FILE_EDIT_MCP_TOKENS="a,b,..." for per-client session isolation —
      # switch to a list in secrets.yaml when a second client needs its own
      # marker set.
      FILE_EDIT_MCP_INSTRUCTIONS: "This server edits the Obsidian vault notes (the vault name is its folder name), rooted at /srv/share/obsidian/notes. When the user refers to their Obsidian notes, the notes vault, or asks e.g. 写入 obsidian notes, they mean this vault: use these tools on files under that root. Notes are UTF-8 markdown with [[wiki links]] and YAML frontmatter; do not rewrite those unless asked."
    volumes:
      # Subtree bind without propagation: remount events above the subtree do
      # not reach it (only a bind of /srv/share itself could receive them).
      # Recovery from a stale CIFS mount is the mylnet-share-watchdog's
      # stop-and-restart cycle, the same tradeoff as the s3 and syncthing
      # stacks.
      - /srv/share/obsidian/notes:/srv/share/obsidian/notes
    ports:
      - "127.0.0.1:{{ file_edit_mcp_local_port }}:8080"
    logging:
      driver: local
